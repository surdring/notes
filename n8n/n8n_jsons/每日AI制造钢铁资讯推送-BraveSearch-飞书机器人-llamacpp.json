      "parameters": {
        "url": "={{ $json.feishuWebhookUrl || $env.FEISHU_BOT_WEBHOOK_URL }}",
        "method": "POST",
        "options": {
          "response": {
            "responseFormat": "json"
          },
          "timeout": 30000
        },
        "sendBody": true,
        "jsonBody": "={\n  \"msg_type\": \"text\",\n  \"content\": {\n    \"text\": $json.text\n  }\n}"
      },
      "typeVersion": 4.2
    }
