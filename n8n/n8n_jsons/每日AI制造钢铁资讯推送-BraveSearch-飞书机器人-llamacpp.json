    {
      "id": "57d4d0d9-60ea-4c44-a4a1-2d20d143ae32",
      "name": "Brave Search (freshness=day)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1080,
        300
      ],
      "parameters": {
        "url": "={{ $json.braveEndpoint }}",
        "method": "GET",
        "options": {
          "response": {
            "responseFormat": "json"
          }
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-Subscription-Token",
              "value": "={{ $env.BRAVE_SEARCH_API_KEY }}"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "count",
              "value": "={{ $json.candidateCount }}"
            },
            {
              "name": "freshness",
              "value": "={{ $json.freshness }}"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "d4e43d2b-1c2d-4ee4-bf43-29a0f4d2d8b4",
      "name": "Pick Candidates",
      "type": "n8n-nodes-base.code",
      "position": [
        1300,
        300
      ],
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst res = $input.first().json.web?.results || $input.first().json.results || [];\n\nfunction normalizeUrl(u) {\n  try {\n    const url = new URL(u);\n    url.hash = '';\n    ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid'].forEach(k => url.searchParams.delete(k));\n    url.search = url.searchParams.toString() ? '?' + url.searchParams.toString() : '';\n    return url.toString();\n  } catch (e) {\n    return u;\n  }\n}\n\nconst seen = new Set();\nconst out = [];\nfor (const r of res) {\n  const url = normalizeUrl(r.url);\n  if (!url || seen.has(url)) continue;\n  seen.add(url);\n\n  out.push({\n    title: r.title,\n    url,\n    description: r.description || r.snippet || '',\n    page_age: r.page_age || r.age || null,\n    source: r.profile?.name || r.source || null,\n    query: cfg.query,\n    llamaBaseUrl: cfg.llamaBaseUrl,\n    llamaModel: cfg.llamaModel,\n    feishuWebhookUrl: cfg.feishuWebhookUrl,\n    finalCount: cfg.finalCount\n  });\n}\n\nreturn out.slice(0, Math.max(cfg.finalCount * 3, 15)).map(j => ({ json: j }));"
      },
      "typeVersion": 2
    },
    {
      "id": "8d1d7027-3f3a-4a2c-8ff8-3c1a5c3eb0a9",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        1520,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "typeVersion": 3
    },
    {
      "id": "7c3e61cc-6701-4a02-9b5f-7748d29c7e9f",
      "name": "Fetch Article (direct)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1740,
        220
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "method": "GET",
        "options": {
          "ignoreResponseCode": true,
          "response": {
            "responseFormat": "text",
            "fullResponse": true
          },
          "timeout": 30000
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "c5d7b0f7-2b77-4a53-8e11-8dff8d8d9d0e",
      "name": "Need Fallback?",
      "type": "n8n-nodes-base.if",
      "position": [
        1960,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "5d9fd6aa-4a02-4b11-9df4-52f68a971c39",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "typeVersion": 2
    },
    {
      "id": "5e44dcb2-3a78-4c47-8c99-89c1d6b2029b",
      "name": "Fetch Article (jina.ai)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2180,
        120
      ],
      "parameters": {
        "url": "={{ 'https://r.jina.ai/http://' + $json.url.replace(/^https?:\\/\\//i, '') }}",
        "method": "GET",
        "options": {
          "ignoreResponseCode": true,
          "response": {
            "responseFormat": "text",
            "fullResponse": true
          },
          "timeout": 30000
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "d2e3c8d0-490e-4f9b-a4e8-f7bfc79c7be2",
      "name": "Select Article Text",
      "type": "n8n-nodes-base.code",
      "position": [
        2400,
        220
      ],
      "parameters": {
        "jsCode": "const base = $input.first().json;\n\nlet body = '';\nif (typeof base.body === 'string') body = base.body;\nif (!body && typeof base.data === 'string') body = base.data;\n\nconst text = (body || '').toString();\n\nreturn [{\n  json: {\n    title: base.title,\n    url: base.url,\n    description: base.description,\n    source: base.source,\n    page_age: base.page_age,\n    articleText: text.slice(0, 60000),\n    llamaBaseUrl: base.llamaBaseUrl,\n    llamaModel: base.llamaModel,\n    feishuWebhookUrl: base.feishuWebhookUrl,\n    finalCount: base.finalCount\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "b4c3c2f0-5f74-4c4d-84ff-70d3e5ac4b47",
      "name": "LLM: Translate + Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2620,
        220
      ],
      "parameters": {
        "url": "={{ $json.llamaBaseUrl.replace(/\\/$/, '') + '/v1/chat/completions' }}",
        "method": "POST",
        "options": {
          "response": {
            "responseFormat": "json"
          },
          "timeout": 120000
        },
        "sendBody": true,
        "jsonBody": "={{ ({\n  model: $json.llamaModel,\n  temperature: 0.2,\n  messages: [\n    { role: 'system', content: '你是一名工业情报分析员，专注 AI 在制造业（尤其钢铁/冶金）中的应用。你必须用中文输出，风格客观、可核查，避免夸大。' },\n    { role: 'user', content:\n      '请基于以下网页内容生成一条资讯解读。要求：\\n' +\n      '1) 如果原文不是中文，先完整翻译为中文（允许适度压缩但不得漏掉关键事实/数字/结论）。\\n' +\n      '2) 输出必须包含：\\n' +\n      '- 标题（中文）\\n' +\n      '- 来源（尽量写网站/机构名）\\n' +\n      '- 发布时间（若无法确定写“未知”）\\n' +\n      '- 资讯摘要（3-5 句）\\n' +\n      '- 与钢铁/制造场景关联点（要具体到工序/设备/系统/指标）\\n' +\n      '- 可信度判断（依据：是否一手来源、是否有数据/案例、是否营销）\\n' +\n      '- 可落地建议（至少 2 条）\\n' +\n      '- 原文链接\\n' +\n      '3) 不要输出与本文无关的泛泛 AI 科普。\\n\\n' +\n      '【网页标题】' + ($json.title || '') + '\\n' +\n      '【网页链接】' + ($json.url || '') + '\\n' +\n      '【网页摘要】' + ($json.description || '') + '\\n' +\n      '【网页内容】\\n' + ($json.articleText || '')\n    }\n  ]\n}) }}"
      },
      "typeVersion": 4.2
    },
    {
      "id": "9a4a9dbf-0b93-4a5a-9226-1d2bd5a7605c",
      "name": "Accumulate Result",
      "type": "n8n-nodes-base.code",
      "position": [
        2840,
        220
      ],
      "parameters": {
        "jsCode": "const data = this.getWorkflowStaticData('global');\nconst input = $input.first().json;\n\nconst content = input?.choices?.[0]?.message?.content || '';\nif (!content) return items;\n\nconst current = data.items || [];\nif (current.length >= 50) {\n  data.items = current;\n  return items;\n}\n\ncurrent.push({\n  content\n});\n\ndata.items = current;\nreturn items;"
      },
      "typeVersion": 2
    },
    {
      "id": "6d9e2b85-2a3e-41c0-9fd8-73c57b0ad8d0",
      "name": "Format Final Message",
      "type": "n8n-nodes-base.code",
      "position": [
        1740,
        500
      ],
      "parameters": {
        "jsCode": "const data = this.getWorkflowStaticData('global');\nconst itemsArr = (data.items || []).slice(0, 5);\n\nif (!itemsArr.length) {\n  return [{ json: { text: '今日未检索到合格的 AI×制造/钢铁 资讯（过去 24 小时）。' } }];\n}\n\nconst header = '【AI×制造/钢铁资讯】过去24小时精选 ' + itemsArr.length + ' 条';\nconst body = itemsArr.map((it, idx) => '\\n\\n---\\n\\n# ' + (idx + 1) + '\\n\\n' + (it.content || '')).join('');\n\nreturn [{ json: { text: header + body } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "d3f5ef24-0a25-4c46-9c49-2b4d9a30309e",
      "name": "Send to Feishu Bot",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1960,
        500
