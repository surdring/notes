      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst data = $getWorkflowStaticData('global');\nconst cfg = $node[\"Init Run Config\"].json;\n\nconst now = Date.now();\nconst windowMs = 48 * 60 * 60 * 1000;\nconst cutoff = now - windowMs;\n\nfunction pickDate(r) {\n  const v = r.isoDate || r.pubDate || r.published || r.date || r.updated || null;\n  if (!v) return null;\n  const t = new Date(v).getTime();\n  if (!Number.isFinite(t)) return null;\n  return t;\n}\n\nfunction normalizeUrl(u) {\n  if (!u) return '';\n  try {\n    const url = new URL(u);\n    url.hash = '';\n    ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid'].forEach(k => url.searchParams.delete(k));\n    url.search = url.searchParams.toString() ? '?' + url.searchParams.toString() : '';\n    return url.toString();\n  } catch (e) {\n    return (u || '').toString().trim();\n  }\n}\n\nfunction containsAny(text, words) {\n  const t = (text || '').toString().toLowerCase();\n  if (!t) return false;\n  return words.some(w => t.includes(w));\n}\n\nconst aiKeywords = [\n  'ai', 'artificial intelligence', 'machine learning', 'deep learning',\n  'llm', 'large language model', 'gpt', 'transformer', 'rag',\n  '人工智能', '机器学习', '深度学习', '大模型', '多模态', '智能体', 'agent'\n];\n\nconst steelKeywords = [\n  'steel', 'iron', 'metallur', 'blast furnace', 'rolling', 'rebar', 'scrap', 'iron ore',\n  '钢', '钢铁', '铁矿', '焦炭', '高炉', '炼钢', '热轧', '冷轧', '螺纹', '废钢'\n];\n\nconst seenThisRun = new Set();\nconst candidates = [];\n\nfor (const item of allItems) {\n  const r = item.json || {};\n\n  const title = (r.title || '').toString();\n  const desc = (r.contentSnippet || r.content || r.description || '').toString();\n\n  const okTopic = true;\n  if (!okTopic) continue;\n\n  const url = normalizeUrl(r.link || r.url);\n  if (!url) continue;\n\n  if (seenThisRun.has(url)) continue;\n  seenThisRun.add(url);\n\n  if (data.sentUrls && data.sentUrls[url]) continue;\n\n  let ts = pickDate(r);\n  const dateMissing = !ts;\n  if (!ts) ts = now;\n\n  if (!dateMissing && ts < cutoff) continue;\n\n  candidates.push({\n    noUpdates: false,\n    title: title || '无标题',\n    url,\n    description: desc,\n    source: r.source || r.creator || r.author || 'RSS Feed',\n    publishedAt: ts,\n    dateMissing,\n    llamaBaseUrl: cfg.llamaBaseUrl,\n    llamaModel: cfg.llamaModel,\n    feishuWebhookUrl: cfg.feishuWebhookUrl,\n    finalCount: cfg.finalCount\n  });\n}\n\nif (candidates.length === 0) {\n  return [{\n    json: {\n      noUpdates: true,\n      title: 'AI/钢铁资讯：48h 内无新增',\n      source: 'RSS Aggregator',\n      summary: '过去 48 小时内没有筛选到可推送的新条目（可能因为源更新慢、关键词过滤未命中，或已推送去重命中）。',\n      url: 'https://worldsteel.org/'\n    }\n  }];\n}\n\n// 排序：有日期的优先，其次按时间从新到旧\ncandidates.sort((a, b) => {\n  if (a.dateMissing !== b.dateMissing) return a.dateMissing ? 1 : -1;\n  return (b.publishedAt || 0) - (a.publishedAt || 0);\n});\n\nreturn candidates.slice(0, 20).map(j => ({ json: j }));"
      },
