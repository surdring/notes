        "jsCode": "const data = $getWorkflowStaticData('global');\nconst cfg = $items('Init Run Config')[0].json;\nconst base = $node['Split In Batches'].json;\n\nconst url = (base?.url || '').toString().trim();\nconst now = Date.now();\n\nif (!data.sentUrls || typeof data.sentUrls !== 'object') data.sentUrls = {};\nif (typeof data.runSentCount !== 'number') data.runSentCount = 0;\n\nif (url) data.sentUrls[url] = now;\n\ndata.runSentCount += 1;\nconst reachedTarget = data.runSentCount >= (cfg.finalCount || 5);\n\nreturn [{ json: { reachedTarget } }];"
