      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\n\n// 最近 30 天内已推送的 URL：{ [url]: epochMs }\nif (!data.sentUrls || typeof data.sentUrls !== 'object') data.sentUrls = {};\n\n// 本次运行计数\ndata.runSentCount = 0;\n\n// 清理过期记录（30 天）\nconst now = Date.now();\nconst retentionMs = 30 * 24 * 60 * 60 * 1000;\nfor (const [u, ts] of Object.entries(data.sentUrls)) {\n  if (!ts || (now - Number(ts)) > retentionMs) {\n    delete data.sentUrls[u];\n  }\n}\n\nreturn items;"
      },
