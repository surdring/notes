    {
      "parameters": {
        "jsCode": "const splitNode = $node[\"Split In Batches\"].json;\nconst jinaRes = $node[\"Fetch Content (jina.ai)\"].json;\n\n// 优先使用 jina.ai 抓取的正文，如果抓取失败或为空，回退使用 RSS 摘要\nlet body = jinaRes.body || jinaRes.data || '';\nif (typeof body !== 'string') body = JSON.stringify(body);\n\nif (!body || body.length < 100) {\n  body = splitNode.description || '';\n}\n\nreturn [{\n  json: {\n    ...splitNode,\n    articleText: body.slice(0, 20000)\n  }\n}];"
      },
